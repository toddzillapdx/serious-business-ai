# Required
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Sender for lead emails. Must be on a domain verified in Resend.
# e.g. "Intake Bot <bot@yourdomain.com>"  (Resend's onboarding@resend.dev works for testing, to your own address only)
EMAIL_FROM=

# Optional: Upstash Redis for per-IP rate limiting. If unset, rate limiting is skipped.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Claude model override
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Per-client lead recipients (referenced from config/clients/*.ts)
EXAMPLE_LEAD_EMAIL=
